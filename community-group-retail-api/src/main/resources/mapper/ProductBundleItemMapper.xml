<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.community.mapper.ProductBundleItemMapper">

    <select id="getProductBundleIdsByProductIds" resultType="java.lang.Long">
        select pack_id from pack_item where prod_id in
        <foreach collection="productIds" item="productId" separator="," open="(" close=")">
            #{productId}
        </foreach>
    </select>

    <insert id="insertBatch" parameterType="list">
        insert into pack_item (pack_id,prod_id,name,price,copies)
        values
        <foreach collection="productBundleItems" item="sd" separator=",">
            (#{sd.productBundleId},#{sd.productId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>
</mapper>
